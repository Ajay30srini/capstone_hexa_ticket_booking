# =========================
# SHARED JWT SETTINGS
# =========================
JWT_SECRET_KEY=change_me_super_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =========================
# POSTGRES COMMON CREDS
# =========================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# =========================
# DATABASE URLs (for Docker containers)
# NOTE: service uses DATABASE_URL injected from docker-compose
# =========================
AUTH_DATABASE_URL=postgresql+psycopg2://postgres:ajay30@auth_db:5432/auth_db
EVENT_DATABASE_URL=postgresql+psycopg2://postgres:ajay30@event_db:5432/event_db
SEAT_DATABASE_URL=postgresql+psycopg2://postgres:ajay30@seat_db:5432/seat_db
BOOKING_DATABASE_URL=postgresql+psycopg2://postgres:ajay30@booking_db:5432/booking_db
PAYMENT_DATABASE_URL=postgresql+psycopg2://postgres:ajay30@payment_db:5432/payment_db

# =========================
# INTERNAL SERVICE URLS (container-to-container)
# =========================
AUTH_URL=http://auth_service:8001
EVENT_URL=http://event_service:8002
SEAT_URL=http://seat_service:8003
BOOKING_URL=http://booking_service:8004
PAYMENT_URL=http://payment_service:8005
GATEWAY_URL=http://gateway:8000