# Shared JWT for ALL services
JWT_SECRET_KEY=change_me_super_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local DBs if running without docker (edit ports/user/pass as you use)
AUTH_DATABASE_URL=postgresql+psycopg2://postgres:ajay30@localhost:5432/auth_db
EVENT_DATABASE_URL=postgresql+psycopg2://postgres:ajay30@localhost:5432/event_db
SEAT_DATABASE_URL=postgresql+psycopg2://postgres:ajay30@localhost:5432/seat_db
BOOKING_DATABASE_URL=postgresql+psycopg2://postgres:ajay30@localhost:5432/booking_db

# service URLs (when services run on these ports)
AUTH_URL=http://127.0.0.1:8001
EVENT_URL=http://127.0.0.1:8002
SEAT_URL=http://127.0.0.1:8003
BOOKING_URL=http://127.0.0.1:8004
PAYMENT_URL=http://127.0.0.1:8005